SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
# Optional: set your machine IP for admin CSRF, e.g. http://192.168.1.10:8000
CSRF_TRUSTED_ORIGINS=
# Set to True only once this is served behind HTTPS (proxy/load balancer with a TLS cert)
USE_HTTPS=False
